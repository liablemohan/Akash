<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>काशी — The Eternal City · A Journey Along the Ghats</title>
  <meta name="description" content="A cinematic scroll journey through the sacred ghats of Varanasi — Dashashwamedh, Manikarnika, Assi, Harishchandra, and Scindia — where the Ganga meets eternity." />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+Devanagari:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- GSAP + ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <style>
    /* ─── Reset & Base ─── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --gold:       #C8973A;
      --parchment:  #F5ECD7;
      --ink:        rgba(10, 6, 2, 0.65);
      --ink-solid:  #0A0602;
    }

    html { scroll-behavior: auto; }

    body {
      background: var(--ink-solid);
      color: var(--parchment);
      font-family: 'EB Garamond', Georgia, serif;
      overflow-x: hidden;
    }

    /* ─── Loading Screen ─── */
    #loader {
      position: fixed;
      inset: 0;
      background: var(--ink-solid);
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 32px;
      transition: opacity 0.9s ease;
    }
    #loader.hidden { opacity: 0; pointer-events: none; }

    /* Stacked, cross-fading logo frames (1..5), centered mid-page */
    .loader-stage {
      position: relative;
      width: min(300px, 62vw);
      aspect-ratio: 508 / 465;
    }
    .loader-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 0;
      filter: drop-shadow(0 0 26px rgba(200, 151, 58, 0.32));
      animation: loader-cycle 5s cubic-bezier(0.45, 0, 0.2, 1) infinite;
    }
    .loader-img:nth-child(1) { animation-delay: 0s; }
    .loader-img:nth-child(2) { animation-delay: -1s; }
    .loader-img:nth-child(3) { animation-delay: -2s; }
    .loader-img:nth-child(4) { animation-delay: -3s; }
    .loader-img:nth-child(5) { animation-delay: -4s; }
    @keyframes loader-cycle {
      0%   { opacity: 0; transform: scale(0.97); }
      6%   { opacity: 1; transform: scale(1); }
      16%  { opacity: 1; transform: scale(1); }
      22%  { opacity: 0; transform: scale(1.02); }
      100% { opacity: 0; transform: scale(1.02); }
    }

    /* Golden loading bar — rolls in step with each frame change */
    .loader-bar-track {
      position: relative;
      width: min(210px, 46vw);
      height: 3px;
      background: rgba(200, 151, 58, 0.18);
      border-radius: 3px;
      overflow: hidden;
    }
    .loader-bar-fill {
      position: absolute;
      top: 0; left: 0;
      height: 100%;
      width: 42%;
      border-radius: 3px;
      background: linear-gradient(90deg,
        transparent,
        var(--gold) 30%,
        #fff3d6 50%,
        var(--gold) 70%,
        transparent);
      animation: loader-bar-roll 1s linear infinite;
    }
    @keyframes loader-bar-roll {
      0%   { transform: translateX(-120%); }
      100% { transform: translateX(340%); }
    }

    /* ─── Buffer Bar (bottom edge — shows bg load after reveal) ─── */
    #buffer-bar {
      position: fixed;
      bottom: 0; left: 0;
      width: 0%;
      height: 2px;
      background: rgba(200, 151, 58, 0.45);
      z-index: 120;
      pointer-events: none;
      transition: width 0.2s linear, opacity 0.5s ease;
    }
    #buffer-bar.complete { opacity: 0; }

    /* ─── Scroll Progress Bar (top-right vertical) ─── */
    #scroll-progress {
      position: fixed;
      top: 0; right: 0;
      width: 2px; height: 100vh;
      background: rgba(200, 151, 58, 0.1);
      z-index: 200;
      pointer-events: none;
    }
    #scroll-progress-fill {
      width: 100%; height: 0%;
      background: var(--gold);
    }

    /* ─── Canvas ─── */
    #main-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      display: block;
      will-change: transform;
      z-index: 1;
    }

    /* ─── Canvas Container (scroll driver) ─── */
    #canvas-container { position: relative; }

    /* ─── Hero Overlay ─── */
    #hero-overlay {
      position: fixed; inset: 0;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      transition: opacity 0.6s ease;
    }
    #hero-overlay.hidden { opacity: 0; pointer-events: none; }

    .hero-kashi {
      font-family: 'Noto Serif Devanagari', serif;
      font-size: clamp(72px, 14vw, 160px);
      font-weight: 300;
      color: var(--parchment);
      letter-spacing: 0.06em;
      line-height: 1;
      text-shadow: 0 2px 40px rgba(0,0,0,0.6);
    }
    .hero-subtitle {
      font-family: 'EB Garamond', serif;
      font-size: clamp(12px, 1.6vw, 17px);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--gold);
      margin-top: 20px;
      opacity: 0.9;
    }
    .hero-rule {
      width: 48px; height: 1px;
      background: var(--gold);
      margin: 24px auto 0;
      opacity: 0.5;
    }

    /* ─── Scroll Prompt ─── */
    .scroll-prompt {
      position: absolute;
      bottom: 52px; left: 50%;
      transform: translateX(-50%);
      display: flex; flex-direction: column;
      align-items: center; gap: 10px;
      pointer-events: none;
    }
    .scroll-prompt-text {
      font-family: 'EB Garamond', serif;
      font-size: 10px;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: rgba(245, 236, 215, 0.45);
    }
    .scroll-arrow {
      width: 1px; height: 38px;
      background: linear-gradient(to bottom, var(--gold), transparent);
      animation: pulse-down 2s ease-in-out infinite;
    }
    @keyframes pulse-down {
      0%, 100% { transform: scaleY(1); opacity: 0.65; }
      50%       { transform: scaleY(1.4); opacity: 1; }
    }

    /* ─── Ghat Overlays ─── */
    .ghat-overlay {
      position: fixed;
      bottom: 80px; left: 48px;
      width: 360px;
      z-index: 20;
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
      will-change: opacity, transform;
      background: var(--ink);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border-left: 1px solid var(--gold);
      padding: 32px;
    }

    .ghat-sanskrit {
      font-family: 'Noto Serif Devanagari', serif;
      font-size: 12px;
      font-weight: 400;
      color: var(--gold);
      letter-spacing: 0.1em;
      margin-bottom: 10px;
      opacity: 0.85;
    }
    .ghat-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(38px, 5vw, 66px);
      font-weight: 300;
      line-height: 1.05;
      color: var(--parchment);
      letter-spacing: 0.01em;
      margin-bottom: 20px;
    }
    .ghat-rule {
      width: 32px; height: 1px;
      background: var(--gold);
      opacity: 0.55;
      margin-bottom: 18px;
    }
    .ghat-desc {
      font-family: 'EB Garamond', serif;
      font-size: 16px;
      line-height: 1.7;
      color: rgba(245, 236, 215, 0.75);
      font-style: italic;
    }

    /* ─── Cinematic Vignette ─── */
    #vignette {
      position: fixed; inset: 0;
      z-index: 5; pointer-events: none;
      background: radial-gradient(ellipse at center,
        transparent 50%,
        rgba(2, 1, 0, 0.55) 100%);
    }

    /* ─── Buffering notice (brief flash when scroll outruns load) ─── */
    #buffer-notice {
      position: fixed;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      z-index: 30;
      font-family: 'EB Garamond', serif;
      font-size: 11px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: rgba(245, 236, 215, 0.5);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    #buffer-notice.visible { opacity: 1; }

    /* ─── End Credit ─── */
    #end-credit {
      position: relative; z-index: 30;
      background: var(--ink-solid);
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 28px; padding: 80px 40px; text-align: center;
    }
    .end-credit-kashi {
      font-family: 'Noto Serif Devanagari', serif;
      font-size: clamp(36px, 6vw, 72px);
      font-weight: 300;
      color: var(--parchment);
      letter-spacing: 0.08em;
    }
    .end-credit-rule { width: 40px; height: 1px; background: var(--gold); opacity: 0.45; }
    .end-credit-quote {
      font-family: 'EB Garamond', serif;
      font-size: clamp(15px, 1.8vw, 21px);
      font-style: italic;
      color: rgba(245, 236, 215, 0.55);
      max-width: 480px; line-height: 1.75;
    }
    .end-credit-attribution {
      font-family: 'EB Garamond', serif;
      font-size: 11px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: var(--gold);
      opacity: 0.45;
    }

    /* ─── Page Navigation (top right) ─── */
    #page-nav {
      position: fixed;
      top: 32px; right: 48px;
      z-index: 50;
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'EB Garamond', serif;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }
    .page-nav-link {
      color: rgba(245, 236, 215, 0.45);
      text-decoration: none;
      transition: color 0.3s ease;
    }
    .page-nav-link:hover,
    .page-nav-link:focus-visible { color: var(--gold); }
    .page-nav-link.active { color: var(--gold); }
    .page-nav-sep { color: rgba(200, 151, 58, 0.35); font-size: 10px; }

    /* ─── Responsive ─── */
    @media (max-width: 600px) {
      .ghat-overlay { left: 16px; right: 16px; width: auto; bottom: 40px; padding: 22px; }
      #page-nav { top: 20px; right: 16px; gap: 8px; font-size: 10px; }
    }
  </style>
