  <script>
  /* ════════════════════════════════════════════════════════
     CONFIGURATION
  ════════════════════════════════════════════════════════ */
  const CONFIG = {
    totalFrames:   2128,          // all source frames, 1:1 from frames_webp

    // Primary format: webp (frames_webp/), fallback: png (frames/)
    frameExt:    'webp',
    frameDir:    'frames_webp_opt',

    framePath: (n, ext, dir) =>
      `${dir}/out_${String(n).padStart(4,'0')}.${ext}`,

    scrollPerFrame: 24,           // optimized: 2128 frames (every 4th of original 8511)
    scrubLag:       0.5,

    // Progressive loading tuning
    quickStart:    60,            // frames before site reveals
    nWorkers:      8,             // parallel background loaders
    lookahead:     200,           // frames to pre-load ahead of scroll position

    sections: [
      { id: 'ghat-0', startFraction: 0,   endFraction: 0.2 },
      { id: 'ghat-1', startFraction: 0.2, endFraction: 0.4 },
      { id: 'ghat-2', startFraction: 0.4, endFraction: 0.6 },
      { id: 'ghat-3', startFraction: 0.6, endFraction: 0.8 },
      { id: 'ghat-4', startFraction: 0.8, endFraction: 1.0 },
    ]
  };

  /* ════════════════════════════════════════════════════════
     DOM REFS
  ════════════════════════════════════════════════════════ */
  const canvas          = document.getElementById('main-canvas');
  const ctx             = canvas.getContext('2d');
  const canvasContainer = document.getElementById('canvas-container');
  const loader          = document.getElementById('loader');
  const heroOverlay     = document.getElementById('hero-overlay');
  const scrollProgFill  = document.getElementById('scroll-progress-fill');
  const bufferBar       = document.getElementById('buffer-bar');
  const bufferNotice    = document.getElementById('buffer-notice');

  /* ════════════════════════════════════════════════════════
     STATE
  ════════════════════════════════════════════════════════ */
  const frames          = new Array(CONFIG.totalFrames).fill(null);
  let currentFrameIdx   = 0;
  let lastDrawnIdx      = -1;
  let rafPending        = false;
  let totalLoaded       = 0;
  let siteRevealed      = false;
  let bufferNoticeTimer = null;

  /* Detect which file extension actually exists (probe frame 1) */
  let frameExt = CONFIG.frameExt;
  let frameDir = CONFIG.frameDir;

  /* ════════════════════════════════════════════════════════
     CANVAS SIZING
  ════════════════════════════════════════════════════════ */
  function resizeCanvas() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resizeCanvas();

  /* ════════════════════════════════════════════════════════
     DRAW — object-fit: cover with dirty flag + RAF
  ════════════════════════════════════════════════════════ */
  function paintImage(img) {
    if (!img || !img.complete || img.naturalWidth === 0) return;
    const cw = canvas.width,  ch = canvas.height;
    const iw = img.naturalWidth, ih = img.naturalHeight;
    const cr = cw / ch, ir = iw / ih;
    let sx, sy, sw, sh;
    if (ir > cr) { sh = ih; sw = ih * cr; sx = (iw - sw) / 2; sy = 0; }
    else          { sw = iw; sh = iw / cr; sx = 0; sy = (ih - sh) / 2; }
    ctx.drawImage(img, sx, sy, sw, sh, 0, 0, cw, ch);
  }

  /* Nearest-available fallback */
  function getBestFrame(idx) {
    if (frames[idx]) return frames[idx];
    for (let d = 1; d < 120; d++) {
      if (idx - d >= 0              && frames[idx - d]) return frames[idx - d];
      if (idx + d < CONFIG.totalFrames && frames[idx + d]) return frames[idx + d];
    }
    return null;
  }

  function requestDraw() {
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(() => {
      rafPending = false;
      if (currentFrameIdx !== lastDrawnIdx) {
        lastDrawnIdx = currentFrameIdx;
        const img = getBestFrame(currentFrameIdx);
        if (img) {
          paintImage(img);
          hidBufferNotice();
        } else {
          showBufferNotice();
        }
      }
    });
  }

  /* ════════════════════════════════════════════════════════
     BUFFER NOTICE (appears when scroll outruns load)
  ════════════════════════════════════════════════════════ */
  function showBufferNotice() {
    clearTimeout(bufferNoticeTimer);
    bufferNotice.classList.add('visible');
  }
  function hidBufferNotice() {
    clearTimeout(bufferNoticeTimer);
    bufferNoticeTimer = setTimeout(() => bufferNotice.classList.remove('visible'), 200);
  }

  /* ════════════════════════════════════════════════════════
     FRAME LOADER — direct WebP (all 8511 files confirmed present)
  ════════════════════════════════════════════════════════ */
  function loadWithFallback(index, frameNumber, onDone) {
    const img = new Image();
    img.onload = () => {
      frames[index] = img;
      totalLoaded++;
      if (index === 0 && siteRevealed) paintImage(img);
      onDone(index);
    };
    img.onerror = () => { frames[index] = null; onDone(index); };
    img.src = CONFIG.framePath(frameNumber, 'webp', 'frames_webp_opt');
  }

  /* ════════════════════════════════════════════════════════
     PHASE 1 — Quick-start: load first N frames → reveal site
  ════════════════════════════════════════════════════════ */
  function probeThenQuickStart() {
    runQuickStart();
  }

  function runQuickStart() {
    const N = CONFIG.quickStart;
    let done = 0;

    for (let i = 0; i < N; i++) {
      const idx = i;
      loadWithFallback(idx, i + 1, () => {
        done++;
        if (idx === 0 && frames[0]) paintImage(frames[0]);
        if (done === N) onQuickStartDone();
      });
    }
  }

  function onQuickStartDone() {
    setTimeout(() => {
      loader.classList.add('hidden');
      siteRevealed = true;
      setTimeout(() => {
        loader.style.display = 'none';
        initScroll();
        paintImage(frames[0]);
        // Phase 2: load all remaining in background
        startBackgroundLoad(CONFIG.quickStart);
      }, 900);
    }, 400);
  }

  /* ════════════════════════════════════════════════════════
     PHASE 2 — Background parallel workers
  ════════════════════════════════════════════════════════ */
  function startBackgroundLoad(fromIdx) {
    let next = fromIdx;
    const total = CONFIG.totalFrames;

    function worker() {
      if (next >= total) return;
      const i = next++;
      if (frames[i]) { worker(); return; }  // skip already-loaded

      loadWithFallback(i, i + 1, () => {
        // Update buffer bar
        const pct = (totalLoaded / total) * 100;
        bufferBar.style.width = pct + '%';
        if (totalLoaded >= total) {
          setTimeout(() => bufferBar.classList.add('complete'), 600);
        }
        worker();
      });
    }

    // Spawn N_WORKERS parallel workers
    const toSpawn = Math.min(CONFIG.nWorkers, CONFIG.totalFrames - fromIdx);
    for (let w = 0; w < toSpawn; w++) {
      worker();
    }
  }

  /* ════════════════════════════════════════════════════════
     LOOKAHEAD — priority-load frames near current position
  ════════════════════════════════════════════════════════ */
  let lookaheadTimer = null;
  function triggerLookahead(idx) {
    clearTimeout(lookaheadTimer);
    lookaheadTimer = setTimeout(() => {
      const end = Math.min(idx + CONFIG.lookahead, CONFIG.totalFrames);
      for (let i = idx; i < end; i++) {
        if (!frames[i]) {
          ((captured) => {
            loadWithFallback(captured, captured + 1, () => {});
          })(i);
        }
      }
    }, 80);
  }

  /* ════════════════════════════════════════════════════════
     GSAP SCROLL ENGINE
  ════════════════════════════════════════════════════════ */
  function initScroll() {
    gsap.registerPlugin(ScrollTrigger);

    const totalScrollH = CONFIG.totalFrames * CONFIG.scrollPerFrame;
    canvasContainer.style.height = totalScrollH + 'px';

    // Main frame scrub
    ScrollTrigger.create({
      trigger:  canvasContainer,
      start:    'top top',
      end:      'bottom bottom',
      scrub:    CONFIG.scrubLag,
      onUpdate: self => {
        const idx = Math.round(self.progress * (CONFIG.totalFrames - 1));
        currentFrameIdx = Math.max(0, Math.min(CONFIG.totalFrames - 1, idx));
        requestDraw();

        // Scroll progress bar
        scrollProgFill.style.height = (self.progress * 100) + '%';

        // Hero fade
        if (self.progress > 0.003) heroOverlay.classList.add('hidden');
        else heroOverlay.classList.remove('hidden');

        // Lookahead
        triggerLookahead(currentFrameIdx);
      }
    });

    /* ── Section ghat overlays ── */
    CONFIG.sections.forEach(section => {
      const el = document.getElementById(section.id);
      if (!el) return;

      const startPx = section.startFraction * totalScrollH;
      const endPx   = section.endFraction   * totalScrollH;
      const fadePx  = Math.min((endPx - startPx) * 0.1, 100);

      // Fade IN
      ScrollTrigger.create({
        trigger:     canvasContainer,
        start:       `top+=${startPx}px top`,
        end:         `top+=${startPx + fadePx}px top`,
        scrub:       0.3,
        onUpdate:    s => {
          gsap.set(el, { opacity: s.progress, y: 16 * (1 - s.progress), immediateRender: false });
        },
        onLeave:     () => gsap.set(el, { opacity: 1, y: 0 }),
        onEnterBack: () => gsap.set(el, { opacity: 1, y: 0 }),
      });

      // Fade OUT
      const fadeOutStart = endPx - fadePx;
      ScrollTrigger.create({
        trigger:     canvasContainer,
        start:       `top+=${fadeOutStart}px top`,
        end:         `top+=${endPx}px top`,
        scrub:       0.3,
        onUpdate:    s => {
          gsap.set(el, { opacity: 1 - s.progress, y: 12 * s.progress, immediateRender: false });
        },
        onLeaveBack: () => gsap.set(el, { opacity: 1, y: 0 }),
      });
    });
  }

  /* ════════════════════════════════════════════════════════
     RESIZE
  ════════════════════════════════════════════════════════ */
  window.addEventListener('resize', () => {
    resizeCanvas();
    const img = getBestFrame(currentFrameIdx);
    if (img) paintImage(img);
    if (siteRevealed) ScrollTrigger.refresh();
  });

  /* ════════════════════════════════════════════════════════
     BOOT
  ════════════════════════════════════════════════════════ */
  probeThenQuickStart();
  </script>
</body>
