  <!-- ══════════ GHAT OVERLAYS ══════════ -->
  <div class="ghat-overlay" id="ghat-0">
    <div class="ghat-sanskrit">दशाश्वमेध घाट</div>
    <div class="ghat-name">Dashashwamedh<br>Ghat</div>
    <div class="ghat-rule"></div>
    <div class="ghat-desc">Where Brahma himself performed the Dasha-ashwamedha yajna — the ten-horse sacrifice — to welcome Lord Shiva back to Kashi. Each evening, the Ganga Aarti transforms this stone into a stage for fire and devotion.</div>
  </div>

  <div class="ghat-overlay" id="ghat-1">
